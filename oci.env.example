# ==========================================
# Oracle Cloud Free Tier Automation Config
# ==========================================

# Path to your OCI API config file (generate from OCI Console > Profile > API Keys)
OCI_CONFIG=/home/ubuntu/oracle-freetier-automation/oci_config

# Availability Domain (e.g. AD-1, AD-2, or full AD name from your OCI Console)
# Separate multiple ADs by commas if your region has multiple (e.g. AD-1,AD-2,AD-3)
OCT_FREE_AD=AD-1

# Custom display name for your new instance
DISPLAY_NAME=my-arm-ubuntu-instance

# Shape to provision:
# - VM.Standard.A1.Flex (ARM Ampere: up to 4 OCPUs, 24 GB RAM Always Free)
# - VM.Standard.E2.1.Micro (AMD x86: 1 OCPU, 1 GB RAM Always Free)
OCI_COMPUTE_SHAPE=VM.Standard.A1.Flex

# Set to True only if creating a SECOND Always-Free Micro instance
SECOND_MICRO_INSTANCE=False

# Retry interval in seconds (recommended: 75 to 90 seconds to avoid rate limiting)
REQUEST_WAIT_TIME_SECS=90

# Absolute path to public SSH key file (will be auto-generated if it does not exist)
SSH_AUTHORIZED_KEYS_FILE=/home/ubuntu/oracle-freetier-automation/id_rsa.pub

# Subnet OCID (required when running on custom host; auto-detected if left blank on Micro instance)
OCI_SUBNET_ID=

# Specific Image OCID (optional). If empty, OPERATING_SYSTEM + OS_VERSION will be used
OCI_IMAGE_ID=
OPERATING_SYSTEM="Canonical Ubuntu"
OS_VERSION=22.04

# Automatically assign an ephemeral public IP (True / False)
ASSIGN_PUBLIC_IP=true

# Boot volume size in GB (50 GB minimum, max 200 GB across all Always-Free instances)
BOOT_VOLUME_SIZE=50

# ------------------------------------------
# Notifications (Optional)
# ------------------------------------------

# Telegram Notifications
TELEGRAM_TOKEN=
TELEGRAM_USER_ID=

# Discord Webhook Notification
DISCORD_WEBHOOK=

# Gmail Notification (Requires Google App Password)
NOTIFY_EMAIL=False
EMAIL=
EMAIL_PASSWORD=
